# Server
PORT=3001
BASE_URL=http://localhost:3001
NODE_ENV=development

# Security
JWT_SECRET=super_secret_learnflow_key_for_development_purposes_123456

# Database
DB_PATH=./db/learnflow.db

# Microsoft Azure App Registration (Mock/optional values for local dev)
MS_CLIENT_ID=your-azure-app-client-id
MS_CLIENT_SECRET=your-azure-app-client-secret
MS_TENANT_ID=your-school-tenant-id
MS_REDIRECT_URI=http://localhost:3001/auth/callback

# File uploads
UPLOAD_MAX_SIZE_MB=50
UPLOAD_DIR=./uploads
