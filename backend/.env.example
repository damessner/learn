# Server
PORT=3001
BASE_URL=https://your-school-server.com
NODE_ENV=production

# Security
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars

# Database
DB_PATH=./db/learnflow.db

# Microsoft Azure App Registration
# Register at: https://portal.azure.com → Azure Active Directory → App registrations
MS_CLIENT_ID=your-azure-app-client-id
MS_CLIENT_SECRET=your-azure-app-client-secret
MS_TENANT_ID=your-school-tenant-id
# Redirect URI must match what you registered in Azure
MS_REDIRECT_URI=https://your-school-server.com/auth/callback

# File uploads
UPLOAD_MAX_SIZE_MB=50
UPLOAD_DIR=./uploads
